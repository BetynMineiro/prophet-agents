{
  "ConnectionStrings": {
    "Default": "",
    "postgresdb": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1",
      "http://127.0.0.1:3000",
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "Storage": {
    "Root": "prophet",
    "BasePath": "./storage",
    "ApiBaseUrl": "https://localhost:7017"
  },
  "Diagnostics": {
    "Metrics": {
      "WindowHours": 1
    },
    "Local": {
      "ApiId": "prophet",
      "ApiName": "Prophet API",
      "BaseUrl": "https://localhost:7017"
    }
  },
  "RateLimit": {
    "Api": { "PermitLimit": 100, "WindowSeconds": 60 }
  },
  "Llm": {
    "Providers": {
      "azure": {
        "Driver": "AzureOpenAI",
        "BaseUrl": "https://YOUR-RESOURCE.openai.azure.com",
        "ApiKey": "",
        "AzureApiVersion": "2024-10-21",
        "AzureOmitTemperature": false
      }
    },
    "Routing": {
      "reasoning": { "Provider": "azure", "Model": "maf-reasoning" },
      "structured": { "Provider": "azure", "Model": "maf-structured" },
      "research": { "Provider": "azure", "Model": "maf-research" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
