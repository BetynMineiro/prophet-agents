{
  "Cors": {
    "AllowedOrigins": [],
    "LocalhostPortFrom": 3000,
    "LocalhostPortTo": 5000
  },
  "Storage": {
    "Root": "prophet",
    "ApiBaseUrl": "https://localhost:7017"
  },
  "RateLimit": {
    "Api": { "PermitLimit": 100, "WindowSeconds": 60 }
  },
  "Llm": {
    "Providers": {
      "azure": {
        "Driver": "AzureOpenAI",
        "BaseUrl": "https://YOUR-RESOURCE.openai.azure.com",
        "ApiKey": "",
        "AzureApiVersion": "2024-10-21",
        "AzureOmitTemperature": false
      }
    },
    "Routing": {
      "reasoning": { "Provider": "azure", "Model": "maf-reasoning" },
      "structured": { "Provider": "azure", "Model": "maf-structured" },
      "research": { "Provider": "azure", "Model": "maf-research" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*"
}
